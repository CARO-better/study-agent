<view class="appearance assistant-appearance theme-{{theme}} {{motionEnabled ? '' : 'reduce-motion'}}">
  <view class="assistant-veil" bindtap="dismiss"></view>
  <view class="assistant-panel glass {{closing ? 'is-closing' : ''}}" style="top:{{top + 8}}px;--panel-enter-x:26px;--panel-enter-y:{{orbTop - top - 8 + 22}}px" catchtap="stop">
    <include src="../../templates/assistant.wxml"/>
  </view>
</view>

<view class="appearance theme-{{theme}} {{motionEnabled ? '' : 'reduce-motion'}}">
  <view class="top-shade" style="height:{{shell.navBottom}}px"></view>
  <button id="assistant-orb" class="ai-orb glass icon-button" style="top:{{shell.orbTop}}px" bindtap="openAI" aria-label="{{showAssistant ? '关闭 AI 助手' : '打开 AI 助手'}}"><image src="/assets/icons/{{showAssistant ? 'x' : 'sparkles'}}-{{theme === 'dark' ? 'blue-dark' : 'blue'}}.svg"/></button>
  <view class="page" style="padding-top:{{shell.navBottom + 20}}px">
    <view class="page-head">
      <view class="page-title">{{tab}}</view>
      <view class="head-actions">
        <button id="sync-anchor" class="icon-button sync-icon" bindtap="openSync" aria-label="{{syncStatus.label}}"><image src="/assets/icons/cloud-{{theme}}.svg"/><view class="status-dot status-{{syncStatus.state}}"></view></button>
        <button id="inbox-anchor" class="icon-button inbox-icon" bindtap="openInbox" aria-label="消息，{{unread || 0}} 条未读"><image src="/assets/icons/bell-{{theme}}.svg"/><view wx:if="{{unread}}" class="unread-dot"></view></button>
      </view>
    </view>
    <view id="sync-alert-anchor" wx:if="{{syncStatus.state === 'error' || syncStatus.state === 'conflict'}}" class="sync-alert" bindtap="openSync"><view class="alert-dot"></view><text>{{syncStatus.state === 'conflict' ? '同步冲突' : '未同步' }}</text><image src="/assets/icons/chevron-right-{{theme}}.svg"/></view>

    <view wx:if="{{tab === '今日'}}" class="content">
      <view wx:if="{{!tasks.length}}" class="empty">暂无待办</view>
      <view class="task-list">
        <view wx:for="{{pendingTasks}}" wx:key="id" id="task-anchor-{{index}}" class="task-row" data-id="{{item.id}}" bindtap="openTask">
          <view class="task-check" data-id="{{item.id}}" catchtap="toggleTask" aria-role="button" aria-label="完成 {{item.title}}"><view class="check"></view></view>
          <view class="task-copy"><view class="task-title">{{item.title}}</view><view wx:if="{{item.meta}}" class="task-meta">{{item.meta}}</view></view>
          <button id="task-more-{{index}}" class="icon-button more-button" data-id="{{item.id}}" catchtap="taskActions" aria-label="{{item.title}} 的更多操作"><image src="/assets/icons/ellipsis-{{theme}}.svg"/></button>
        </view>
      </view>
      <view wx:if="{{completedCount}}" class="completed-toggle" bindtap="toggleCompleted">已完成 {{completedCount}}<image class="{{showCompleted ? 'expanded' : ''}}" src="/assets/icons/chevron-right-{{theme}}.svg"/></view>
      <view wx:if="{{showCompleted}}" class="task-list completed-list"><view wx:for="{{completedTasks}}" wx:key="id" id="done-task-anchor-{{index}}" class="task-row"><view class="task-check" data-id="{{item.id}}" bindtap="toggleTask" aria-role="button" aria-label="将 {{item.title}} 标为未完成"><view class="check checked"><image src="/assets/icons/check-dark.svg"/></view></view><view class="task-copy" data-id="{{item.id}}" bindtap="openTask"><view class="task-title done">{{item.title}}</view></view><button id="done-task-more-{{index}}" class="icon-button more-button" data-id="{{item.id}}" catchtap="taskActions" aria-label="更多操作"><image src="/assets/icons/ellipsis-{{theme}}.svg"/></button></view></view>
      <view wx:if="{{blocks.length}}" class="group-heading">接下来</view>
      <view wx:for="{{blocks}}" wx:key="index" class="schedule-row"><view class="schedule-rail"></view><view class="grow"><view>{{item.title}}</view><view class="task-meta">{{item.timeLabel}}</view></view><image wx:if="{{item.locked}}" class="small-icon" src="/assets/icons/lock-keyhole-{{theme}}.svg"/></view>
    </view>

    <view wx:if="{{tab === '课程'}}" class="content">
      <view wx:if="{{!store.courses.length}}" class="empty">暂无课程</view>
      <view class="grouped-list"><view wx:for="{{store.courses}}" wx:key="id" id="course-anchor-{{index}}" class="course-row" data-id="{{item.id}}" bindtap="openCourse"><view class="grow"><view class="row-title">{{item.name}}</view><view class="task-meta">{{item.semester}}</view></view><button id="course-more-{{index}}" class="icon-button" data-id="{{item.id}}" catchtap="courseActions" aria-label="{{item.name}} 的更多操作"><image src="/assets/icons/ellipsis-{{theme}}.svg"/></button></view></view>
    </view>

    <view wx:if="{{tab === '计划'}}" class="content">
      <view class="group-heading first">可用时间</view><view wx:if="{{!availability.length}}" class="empty inline">未添加</view>
      <view class="grouped-list"><view wx:for="{{availability}}" wx:key="id" id="availability-anchor-{{index}}" class="interval-row"><view class="grow"><view>{{item.startTime}}–{{item.endTime}}</view><view class="task-meta">{{item.date}}</view></view><button class="icon-button" data-kind="availability" data-id="{{item.id}}" bindtap="remove" aria-label="删除可用时间"><image src="/assets/icons/x-{{theme}}.svg"/></button></view></view>
      <view class="group-heading">固定安排</view><view wx:if="{{!fixedBlocks.length}}" class="empty inline">未添加</view>
      <view class="grouped-list"><view wx:for="{{fixedBlocks}}" wx:key="id" id="fixed-anchor-{{index}}" class="interval-row"><view class="grow"><view>{{item.title}}</view><view class="task-meta">{{item.date}} {{item.startTime}}–{{item.endTime}}</view></view><button class="icon-button" data-kind="fixed" data-id="{{item.id}}" bindtap="remove" aria-label="删除固定安排"><image src="/assets/icons/x-{{theme}}.svg"/></button></view></view>
      <view class="plan-toolbar"><button id="generate-plan" class="primary plan-button" bindtap="generate" disabled="{{planBusy}}" loading="{{planBusy}}">生成计划</button><button id="undo-plan" class="icon-button glass" bindtap="undo" aria-label="撤销上次排期"><image src="/assets/icons/rotate-ccw-{{theme}}.svg"/></button></view>
      <view wx:if="{{planMessage}}" class="notice">{{planMessage}}</view>
      <view class="group-heading">排期</view><view wx:if="{{!blocks.length}}" class="empty inline">暂无排期</view>
      <view wx:for="{{blocks}}" wx:key="index" class="schedule-row"><view class="schedule-rail"></view><view class="grow"><view>{{item.title}}</view><view class="task-meta">{{item.timeLabel}}</view></view><button class="icon-button" data-index="{{index}}" bindtap="lock" aria-label="{{item.locked ? '解除锁定' : '锁定安排'}}"><image src="/assets/icons/{{item.locked ? 'lock-keyhole' : 'lock-keyhole-open'}}-{{theme}}.svg"/></button></view>
      <view wx:if="{{unscheduled.length}}" class="group-heading">未安排</view>
      <view wx:for="{{unscheduled}}" wx:key="index" class="interval-row"><view class="grow"><view>{{item.title}}</view><view class="task-meta">{{item.reasonLabel}}</view></view><view class="task-meta">{{item.remainingMinutes}} 分钟</view></view>
    </view>

    <view wx:if="{{tab === '设置'}}" class="content settings-content">
      <view class="grouped-list settings-group"><view id="appearance-anchor" class="settings-row" bindtap="chooseAppearanceMenu"><text>外观</text><view class="row-value">{{appearanceMode === 'dark' ? '深色' : appearanceMode === 'light' ? '浅色' : '跟随系统'}}<image class="chevron" src="/assets/icons/chevron-right-{{theme}}.svg"/></view></view><view class="settings-row"><text>动效</text><switch checked="{{motionEnabled}}" color="#0069D9" bindchange="toggleMotion"/></view></view>
      <view class="grouped-list settings-group"><view id="settings-sync-anchor" class="settings-row" bindtap="openSync"><text>同步</text><view class="row-value"><view class="status-dot static status-{{syncStatus.state}}"></view><image class="chevron" src="/assets/icons/chevron-right-{{theme}}.svg"/></view></view><view id="settings-model-anchor" class="settings-row" bindtap="openModelSettings"><text>模型</text><image class="chevron" src="/assets/icons/chevron-right-{{theme}}.svg"/></view></view>
      <view class="group-heading">备份</view><view class="grouped-list settings-group"><view id="export-backup-anchor" class="settings-row" bindtap="exportBackup"><text>导出</text><image class="small-icon" src="/assets/icons/download-{{theme}}.svg"/></view><view id="import-backup-anchor" class="settings-row" bindtap="importBackup"><text>导入</text><image class="small-icon" src="/assets/icons/upload-{{theme}}.svg"/></view><view id="restore-recovery-anchor" class="settings-row" bindtap="restoreRecovery"><text>恢复副本</text><image class="small-icon" src="/assets/icons/rotate-ccw-{{theme}}.svg"/></view></view>
      <view id="settings-more-anchor" class="settings-more" bindtap="settingsMore" aria-role="button" aria-label="更多设置"><image src="/assets/icons/ellipsis-{{theme}}.svg"/></view>
    </view>
  </view>

  <view class="dock"><view class="tab-bar glass"><view wx:for="{{tabs}}" wx:key="*this" class="nav {{tab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="switchTab" aria-role="button" aria-label="{{tab === item ? item + '，当前页面' : item}}"><image src="/assets/icons/{{['list-todo','book-open','calendar-days','settings-2'][index]}}-{{tab === item ? (theme === 'dark' ? 'blue-dark' : 'blue') : theme}}.svg"/></view></view><button wx:if="{{tab !== '设置'}}" id="quick-add" class="quick-add glass icon-button" bindtap="quickAdd" aria-label="{{tab === '课程' ? '添加课程' : tab === '计划' ? '添加时间' : '添加任务'}}"><image src="/assets/icons/plus-{{theme === 'dark' ? 'blue-dark' : 'blue'}}.svg"/></button></view>

  <surface-panel id="surface" visible="{{surfaceVisible}}" revision="{{surfaceRevision}}" anchor="{{surfaceAnchor}}" anchor-radius="{{surfaceAnchorRadius}}" size="{{surfaceSize}}" motion-enabled="{{motionEnabled}}" bind:dismiss="closeSurface" bind:closed="surfaceClosed">
    <block wx:if="{{surfaceKind === 'editor'}}">
      <view class="sheet-head editor-head"><button class="icon-button" bindtap="close" aria-label="取消编辑"><image src="/assets/icons/x-{{theme}}.svg"/></button><view class="sheet-title">{{editing === 'course' ? '课程' : editing === 'task' ? '任务' : availabilityForm.fixed ? '固定时间' : '可用时间'}}</view><button class="icon-button" bindtap="saveEditor" aria-label="保存"><image src="/assets/icons/check-{{theme === 'dark' ? 'blue-dark' : 'blue'}}.svg"/></button></view>
      <view class="sheet-body">
        <block wx:if="{{editing === 'course'}}"><view class="label">学期</view><input placeholder-style="color:{{theme === 'dark' ? '#A0A0AA' : '#60616B'}}" class="input" placeholder="例如 2026 秋季" value="{{courseForm.semester}}" data-field="semester" bindinput="field" adjust-position="{{false}}"/><view class="label">课程名称</view><input placeholder-style="color:{{theme === 'dark' ? '#A0A0AA' : '#60616B'}}" class="input" placeholder="例如 软件工程" value="{{courseForm.name}}" data-field="name" bindinput="field" adjust-position="{{false}}"/><view class="label">课程重要度</view><picker range="{{priorities}}" value="{{courseForm.importanceIndex}}" data-field="importanceIndex" bindchange="field"><view class="input">{{priorities[courseForm.importanceIndex]}} ▾</view></picker><view class="label">掌握程度</view><picker range="{{['薄弱','一般','熟悉']}}" value="{{courseForm.masteryIndex}}" data-field="masteryIndex" bindchange="field"><view class="input">{{courseForm.masteryIndex === 0 ? '薄弱' : courseForm.masteryIndex === 2 ? '熟悉' : '一般'}} ▾</view></picker></block>
        <block wx:if="{{editing === 'task'}}"><view class="label">任务标题</view><input placeholder-style="color:{{theme === 'dark' ? '#A0A0AA' : '#60616B'}}" class="input" placeholder="例如 完成实验报告" value="{{taskForm.title}}" data-field="title" bindinput="field" adjust-position="{{false}}"/><view class="label">关联课程</view><picker range="{{courseNames}}" value="{{courseIndex}}" bindchange="chooseCourse"><view class="input">{{courseNames[courseIndex]}} ▾</view></picker><view class="label">类型</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="chooseType"><view class="input">{{types[typeIndex]}} ▾</view></picker><view class="label">截止日期</view><picker mode="date" value="{{taskForm.dueAt}}" data-field="dueAt" bindchange="field"><view class="input">{{taskForm.dueAt || '未设置（可留空）'}} ▾</view></picker><text class="link" bindtap="clearDeadline">清除</text><view class="label">剩余分钟</view><input placeholder-style="color:{{theme === 'dark' ? '#A0A0AA' : '#60616B'}}" class="input" type="number" value="{{taskForm.remainingMinutes}}" data-field="remainingMinutes" bindinput="field" adjust-position="{{false}}"/><view class="label">优先级</view><picker range="{{priorities}}" value="{{priorityIndex}}" bindchange="choosePriority"><view class="input">{{priorities[priorityIndex]}} ▾</view></picker><view wx:if="{{typeIndex === 2}}"><view class="label">考试范围 / 复习考点</view><textarea placeholder-style="color:{{theme === 'dark' ? '#A0A0AA' : '#60616B'}}" class="input scope-input" maxlength="2000" placeholder="例如：极限、导数、积分" value="{{taskForm.examScope}}" data-field="examScope" bindinput="field" adjust-position="{{false}}"/></view></block>
        <block wx:if="{{editing === 'availability'}}"><view class="label">日期</view><picker mode="date" value="{{availabilityForm.date}}" data-field="date" bindchange="field"><view class="input">{{availabilityForm.date}} ▾</view></picker><view class="label">开始</view><picker mode="time" value="{{availabilityForm.start}}" data-field="start" bindchange="field"><view class="input">{{availabilityForm.start}} ▾</view></picker><view class="label">结束</view><picker mode="time" value="{{availabilityForm.end}}" data-field="end" bindchange="field"><view class="input">{{availabilityForm.end}} ▾</view></picker><view wx:if="{{availabilityForm.fixed}}"><view class="label">名称</view><input placeholder-style="color:{{theme === 'dark' ? '#A0A0AA' : '#60616B'}}" class="input" value="{{availabilityForm.title}}" data-field="title" bindinput="field" adjust-position="{{false}}"/><view class="label">重复周数（1—30）</view><input placeholder-style="color:{{theme === 'dark' ? '#A0A0AA' : '#60616B'}}" class="input" type="number" value="{{availabilityForm.repeatWeeks}}" data-field="repeatWeeks" bindinput="field" adjust-position="{{false}}"/></view></block>
      </view>
    </block>
    <block wx:elif="{{surfaceKind === 'sync'}}">
      <view class="sheet-head"><view class="sheet-title">同步</view><button class="icon-button" bindtap="closeSync" aria-label="关闭同步详情"><image src="/assets/icons/x-{{theme}}.svg"/></button></view>
      <view class="sheet-body"><view class="sync-detail">{{syncStatus.label}}</view><view wx:if="{{syncStatus.updatedAt}}" class="task-meta">{{syncTime}}</view><view class="button-row"><button class="primary" bindtap="uploadToCloud">{{syncStatus.state === 'conflict' ? '保留本机' : '立即同步' }}</button><button class="secondary" bindtap="restoreFromCloud">恢复云端</button></view></view>
    </block>
    <block wx:elif="{{surfaceKind === 'inbox'}}">
      <view class="sheet-head"><view class="sheet-title">消息</view><button class="icon-button" bindtap="closeInbox" aria-label="关闭消息"><image src="/assets/icons/x-{{theme}}.svg"/></button></view>
      <view class="sheet-body"><view wx:if="{{!inboxMessages.length}}" class="empty inline">暂无消息</view><view wx:for="{{inboxMessages}}" wx:key="date" class="inbox-day"><view class="inbox-date">{{item.date}}<text>{{item.summary}}</text></view><view wx:for="{{item.items}}" wx:for-item="task" wx:key="taskId" class="inbox-task" data-id="{{task.taskId}}" bindtap="toggleFromInbox"><view class="check {{task.overdue ? 'overdue' : ''}}"></view><view class="grow"><view>{{task.title}}</view><view class="task-meta">{{task.dueAt}}</view></view></view></view></view>
    </block>
    <block wx:elif="{{surfaceKind === 'resources'}}">
      <view class="sheet-head"><view class="sheet-title">复习资源</view><button class="icon-button" bindtap="closeResources" aria-label="关闭复习资源"><image src="/assets/icons/x-{{theme}}.svg"/></button></view>
      <view class="sheet-body"><view class="task-meta resource-notice">{{resourceNotice}}</view><view wx:for="{{resources}}" wx:key="taskId" class="resource-group"><view class="group-heading">{{item.taskTitle}}</view><view wx:if="{{!item.items.length}}" class="empty inline">暂无匹配视频</view><view wx:for="{{item.items}}" wx:for-item="video" wx:key="bvid" class="resource-row" data-url="{{video.url}}" bindtap="copyResource"><view class="grow"><view>{{video.title}}</view><view class="task-meta">{{video.author}}</view></view><image class="small-icon" src="/assets/icons/link-{{theme}}.svg"/></view></view></view>
    </block>
  </surface-panel>

  <assistant-panel wx:if="{{showAssistant || assistantClosing}}" id="assistant" top="{{shell.navBottom}}" orb-top="{{shell.orbTop}}" closing="{{assistantClosing}}" settings-open="{{assistantSettings}}" bind:dismiss="closeAssistant"/>
  <app-dialog id="app-dialog" motion-enabled="{{motionEnabled}}"/>
</view>

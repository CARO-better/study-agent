.motion{width:144rpx;height:144rpx;position:relative;margin:auto}.canvas,.fallback{position:absolute;width:100%;height:100%;left:0;top:0}.fallback{display:flex;align-items:center;justify-content:center}.concealed{visibility:hidden}.paper{width:72rpx;height:88rpx;border:4rpx solid #0A84FF;border-radius:12rpx;transform:rotate(-6deg);padding:16rpx;box-sizing:border-box}.line{height:4rpx;background:#0A84FF;border-radius:4rpx;margin:8rpx 0}.short{width:60%}.tick{color:#0A84FF;font-size:32rpx;line-height:28rpx;text-align:right}

.assistant-layout { display: flex; flex-direction: column; height: 100%; min-height: 0; }
.assistant-head { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 8px 12px 0 24px; }
.assistant-name { font-size: 20px; font-weight: 600; }
.assistant-notice { margin: 8px 20px 0; color: var(--secondary); font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; }
.actionable { display: flex; align-items: center; gap: 4px; color: var(--blue); }
.actionable image { width: 14px; height: 14px; }
.assistant-thread { flex: 1; min-height: 0; height: 0; box-sizing: border-box; width: 100%; }
.assistant-welcome { padding: 56px 0 40px; }
.assistant-thread.has-messages .assistant-welcome { display: none !important; height: 0; padding: 0; overflow: hidden; }
.message { margin: 16px 20px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
.message.user { align-items: flex-end; }
.bubble { max-width: 90%; box-sizing: border-box; padding: 12px 16px; overflow-wrap: anywhere; font-size: 16px; line-height: 1.65; }
.bubble-copy { white-space: pre-wrap; overflow-wrap: anywhere; }
.user .bubble { color: var(--text); background: var(--fill); border-radius: 22px 22px 6px 22px; }
.assistant .bubble { color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 22px 22px 22px 6px; box-shadow: 0 1px 2px var(--glass-shadow); overflow: hidden; }
.system .bubble { color: var(--secondary); font-size: 13px; padding: 0 4px; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.message-image { width: 60%; max-width: 220px; border-radius: 18px; overflow: hidden; margin-bottom: 8px; }
.message-image image { display: block; width: 100%; }
.thinking { display: flex; gap: 5px; padding: 16px 24px; }
.thinking view { width: 5px; height: 5px; border-radius: 50%; background: var(--blue); animation: thinking-pulse 1.2s infinite; }
.thinking view:nth-child(2) { animation-delay: .15s; }
.thinking view:nth-child(3) { animation-delay: .3s; }
.thread-end { height: 16px; }
.assistant-composer { flex-shrink: 0; margin: 8px 12px 12px; border-radius: 28px; background: var(--surface); }
.composer-row { display: flex; align-items: center; padding: 4px; gap: 4px; }
.chat-input { min-width: 0; flex: 1; color: var(--text); font-size: 16px; height: 44px; }
.send-button { background: #0069D9; }
.image-preview { position: relative; width: 80px; height: 80px; margin: 12px; }
.image-preview>image { width: 100%; height: 100%; border-radius: 16px; }
.preview-remove { position: absolute; top: -12px; right: -16px; background: var(--surface); }
.image-processing-canvas { position: fixed; left: 12px; top: 12px; width: 1px; height: 1px; opacity: .01; pointer-events: none; z-index: -1; }
.rich, .rich towxml { display: block; box-sizing: border-box; min-width: 0; max-width: 100%; }
.rich { overflow-x: auto; overflow-y: hidden; }
.model-overlay { position: absolute; inset: 0; z-index: 5; border-radius: inherit; display: flex; align-items: center; justify-content: center; padding: 12px; background: var(--veil); animation: model-veil-in .2s ease-out; }
.model-sheet { width: 88%; max-width: 460px; max-height: 88%; border-radius: 28px; transform-origin: calc(100% - 40px) 20px; animation: model-sheet-in .26s cubic-bezier(.2,.8,.2,1); }
.model-overlay.model-closing { pointer-events: none; animation: model-veil-out .18s ease-in forwards; }
.model-overlay.model-closing .model-sheet { animation: model-sheet-out .18s cubic-bezier(.55,0,1,.45) forwards; }
@keyframes model-veil-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes model-veil-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes model-sheet-in { from { opacity: 0; transform: translate(8px, -10px) scale(.96); } to { opacity: 1; transform: translate(0, 0) scale(1); } }
@keyframes model-sheet-out { from { opacity: 1; transform: translate(0, 0) scale(1); } to { opacity: 0; transform: translate(8px, -10px) scale(.96); } }
.preset-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 20px; }
.preset { padding: 9px 12px; font-size: 13px; color: var(--secondary); background: var(--fill); border-radius: 20px; border: 1px solid transparent; }
.preset.selected { color: var(--blue); border-color: var(--blue); }
.model-help { color: var(--blue); font-size: 13px; padding: 20px 0 4px; }
@keyframes thinking-pulse { 0%,80%,100% { opacity: .3; } 40% { opacity: 1; } }

.welcome-symbol{display:block;width:36px;height:36px;margin:16px auto;}

.send-button[disabled]{background:#0069D9;}

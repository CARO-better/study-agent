.page{padding:40rpx 32rpx 160rpx}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28rpx}.eyebrow{font-size:21rpx;letter-spacing:3rpx;color:#7888A5;font-weight:600}.heading{font-size:56rpx;font-weight:700;margin-top:8rpx}.local{font-size:23rpx;color:#2457D6;background:#E5ECFF;padding:10rpx 16rpx;border-radius:12rpx}.notice{font-size:24rpx;line-height:1.6;color:#526580;background:#E9EFF9;padding:20rpx 24rpx;border-radius:16rpx;margin-bottom:36rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin:30rpx 0 20rpx;gap:12rpx}.section-title{font-weight:700;font-size:34rpx}.sub{font-size:24rpx;color:#74839A;line-height:1.6;margin-top:6rpx}.primary{background:#2457D6;color:white;border-radius:14rpx;font-weight:600}.small{font-size:25rpx;margin:0;padding:0 22rpx;line-height:68rpx}.secondary{background:#E8EEF9;color:#2457D6;border-radius:14rpx}.card{background:#fff;border-radius:18rpx;padding:26rpx;margin-bottom:16rpx}.task-main{display:flex;align-items:flex-start;gap:20rpx}.check{width:36rpx;height:36rpx;border:2rpx solid #A8B7CB;border-radius:50%;flex-shrink:0;text-align:center;line-height:36rpx;color:white;margin-top:4rpx}.checked{background:#13745C;border-color:#13745C}.task-title{font-weight:650;font-size:30rpx}.done{text-decoration:line-through;color:#8896AA}.actions{display:flex;justify-content:flex-end;gap:30rpx;color:#526E9D;font-size:24rpx;margin-top:12rpx}.course,.row{display:flex;justify-content:space-between;align-items:center}.empty{padding:36rpx 26rpx;color:#7A8BA2;background:#ECF1F8;border-radius:16rpx;line-height:1.6}.compact{padding:22rpx}.link{color:#2457D6;font-size:25rpx}.timeline{display:flex;align-items:center;gap:20rpx;background:white;padding:20rpx;margin:10rpx 0;border-radius:12rpx}.rail{align-self:stretch;width:6rpx;border-radius:8rpx;background:#2457D6}.grow{flex:1}.row{padding:20rpx 4rpx;border-bottom:1rpx solid #DEE6F1}.button-row{display:flex;gap:16rpx;margin:30rpx 0}.button-row button{flex:1;font-size:25rpx;padding:0 10rpx}.space{margin:38rpx 0 16rpx}.prose{line-height:1.8;color:#536680}.sample{margin:34rpx 0 12rpx}.bottom{position:fixed;bottom:0;left:0;right:0;background:white;display:flex;padding:20rpx 0 calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #E7EDF5}.nav{flex:1;text-align:center;color:#8290A4;font-size:25rpx}.active{color:#2457D6;font-weight:700}.overlay{position:fixed;inset:0;background:rgba(20,33,61,.45);display:flex;align-items:flex-end;z-index:10}.sheet{box-sizing:border-box;width:100%;max-height:90vh;overflow-y:auto;background:#fff;border-radius:28rpx 28rpx 0 0;padding:32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom))}.sheet-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}.label{font-size:25rpx;color:#526580;margin:20rpx 0 8rpx}.input{box-sizing:border-box;background:#F4F7FC;border-radius:12rpx;padding:18rpx 20rpx;min-height:78rpx}.submit{margin-top:32rpx}
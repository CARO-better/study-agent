.page { box-sizing:border-box; max-width:640px; margin:0 auto; padding:0 20px calc(116px + env(safe-area-inset-bottom)); }
.top-shade { position:fixed; z-index:20; top:0; left:0; right:0; background:var(--bg); }
.ai-orb { position:fixed; z-index:80; left:16px; width:44px; height:44px; }
.ai-orb image { width:23px; height:23px; }
.page-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:0 0 24px; }
.page-title { font-size:34px; font-weight:700; line-height:1.2; letter-spacing:-1px; }
.head-actions { display:flex; align-items:center; gap:0; }
.sync-icon,.inbox-icon { position:relative; }
.status-dot { position:absolute; right:8px; bottom:9px; width:6px; height:6px; border:2px solid var(--bg); border-radius:50%; background:var(--secondary); }
.status-dot.static { position:static; width:7px; height:7px; border:0; }
.status-synced { background:var(--green); }
.status-error,.status-conflict { background:var(--orange); }
.status-pending,.status-syncing { background:var(--blue); }
.unread-dot { position:absolute; top:8px; right:9px; width:6px; height:6px; border-radius:50%; background:var(--red); border:2px solid var(--bg); }
.sync-alert { display:flex; align-items:center; gap:6px; color:var(--orange); font-size:13px; margin:-12px 0 20px; min-height:28px; }
.sync-alert image { width:12px; height:12px; opacity:.6; }
.alert-dot { width:5px; height:5px; border-radius:50%; background:var(--orange); }
.task-row { display:flex; align-items:flex-start; min-height:76px; gap:4px; }
.task-check { display:flex; justify-content:flex-start; align-items:flex-start; box-sizing:border-box; padding-top:15px; padding-left:10px; margin-left:-10px; width:44px; min-height:56px; flex-shrink:0; }
.check { box-sizing:border-box; width:23px; height:23px; border:1.5px solid var(--secondary); border-radius:50%; flex-shrink:0; }
.check image { width:17px; height:17px; margin:1.5px; }
.checked { background:var(--green); border-color:var(--green); }
.task-copy { flex:1; min-width:0; padding:14px 0 18px; border-bottom:1px solid var(--line); }
.task-title { font-size:17px; font-weight:500; line-height:1.45; overflow-wrap:anywhere; }
.task-meta { color:var(--secondary); font-size:13px; line-height:1.5; margin-top:4px; overflow-wrap:anywhere; }
.more-button { margin-top:4px; margin-right:-12px; opacity:.7; }
.done { color:var(--secondary); text-decoration:line-through; }
.completed-toggle { display:flex; align-items:center; gap:4px; color:var(--secondary); font-size:13px; padding:20px 0 12px 38px; }
.completed-toggle image { width:13px; height:13px; }
.expanded { transform:rotate(90deg); }
.group-heading { font-size:13px; font-weight:500; color:var(--secondary); margin:28px 0 8px; }
.group-heading.first { margin-top:0; }
.grouped-list { background:var(--surface); border-radius:20px; overflow:hidden; }
.grouped-list:empty { display:none; }
.course-row,.interval-row { display:flex; align-items:center; min-height:64px; gap:12px; padding:8px 12px 8px 16px; border-bottom:1px solid var(--line); box-sizing:border-box; }
.course-row:last-child,.interval-row:last-child { border-bottom:0; }
.row-title { font-size:17px; font-weight:500; }
.interval-row { padding-left:0; }
.grouped-list .interval-row { padding-left:16px; }
.plan-toolbar { display:flex; align-items:center; gap:12px; margin:24px 0; }
.plan-button { flex:1; }
.schedule-row { display:flex; align-items:center; gap:12px; padding:14px 0; border-bottom:1px solid var(--line); }
.schedule-rail { width:3px; height:36px; flex-shrink:0; border-radius:4px; background:var(--blue); }
.settings-group { margin-bottom:24px; }
.settings-row { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:8px 16px; min-height:54px; box-sizing:border-box; border-bottom:1px solid var(--line); }
.settings-row:last-child { border-bottom:0; }
.settings-row switch { transform:scale(.82); transform-origin:right center; margin-right:-2px; }
.row-value { display:flex; align-items:center; gap:8px; color:var(--secondary); font-size:15px; }
.chevron { width:15px; height:15px; opacity:.45; }
.settings-more { display:flex; justify-content:center; align-items:center; min-height:44px; }
.settings-more image { width:24px; height:24px; opacity:.6; }
.dock { position:fixed; z-index:25; bottom:calc(12px + env(safe-area-inset-bottom)); left:16px; right:16px; max-width:440px; margin:auto; display:flex; gap:12px; align-items:center; }
.tab-bar { display:flex; box-sizing:border-box; flex:1; min-width:0; padding:5px; border-radius:36px; height:62px; }
.nav { flex:1; min-width:0; display:flex; align-items:center; justify-content:center; border-radius:28px; }
.nav image { width:24px; height:24px; opacity:.65; }
.nav.active { background:var(--fill); }
.nav.active image { opacity:1; }
.quick-add { width:62px; height:62px; }
.quick-add image { width:28px; height:28px; }
.scope-input { height:100px; }
.sync-detail { font-size:16px; padding-top:8px; }
.inbox-day { padding:16px 0; border-bottom:1px solid var(--line); }
.inbox-date { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; font-weight:600; font-size:14px; }
.inbox-date text { color:var(--secondary); font-size:12px; font-weight:400; }
.inbox-task { display:flex; align-items:flex-start; gap:12px; padding:16px 0 0; font-size:15px; }
.check.overdue { border-color:var(--red); }
.resource-row { display:flex; align-items:center; gap:16px; padding:16px 0; border-bottom:1px solid var(--line); font-size:15px; }
.resource-notice { padding:8px 0; }
@media(max-width:350px) { .page { padding-left:16px; padding-right:16px; } .dock { gap:8px; left:12px; right:12px; } .quick-add { width:56px; height:56px; } .tab-bar { height:56px; } }

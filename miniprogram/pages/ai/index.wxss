.chat{display:flex;flex-direction:column;min-height:100vh;background:#F4F7FC}
.chat-head{display:flex;justify-content:space-between;align-items:center;padding:28rpx 32rpx 12rpx}
.chat-title{font-size:38rpx;font-weight:700}
.link{color:#2457D6;font-size:25rpx}
.notice{margin:12rpx 32rpx;padding:18rpx 22rpx;background:#E9EFF9;color:#526580;border-radius:14rpx;font-size:24rpx;line-height:1.6}
.thread{flex:1;padding:16rpx 32rpx 200rpx}
.empty{padding:36rpx 26rpx;color:#7A8BA2;background:#ECF1F8;border-radius:16rpx;line-height:1.7;font-size:25rpx}
.msg{margin:16rpx 0;display:flex;flex-direction:column}
.msg.user{align-items:flex-end}
.msg.assistant{align-items:flex-start}
.msg.system{align-items:center}
.bubble{max-width:84%;padding:20rpx 24rpx;border-radius:18rpx;font-size:28rpx;line-height:1.6;background:#fff;color:#1E2A3D}
.msg.user .bubble{background:#2457D6;color:#fff}
.msg.system .bubble{background:transparent;color:#7A8BA2;font-size:23rpx;padding:6rpx 0;text-align:center;max-width:100%}
.thinking{color:#7A8BA2;font-style:normal}
.thumb{max-width:60%;margin-bottom:10rpx;border-radius:14rpx;overflow:hidden;background:#fff}
.thumb image{width:100%;display:block}
.composer{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1rpx solid #E7EDF5;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom))}
.preview{position:relative;width:120rpx;height:120rpx;margin-bottom:12rpx}
.preview image{width:100%;height:100%;border-radius:12rpx}
.remove{position:absolute;top:-10rpx;right:-10rpx;width:36rpx;height:36rpx;line-height:32rpx;text-align:center;border-radius:50%;background:#D64545;color:#fff;font-size:26rpx}
.composer-row{display:flex;align-items:center;gap:12rpx}
.icon{flex-shrink:0;font-size:24rpx;padding:0 18rpx;line-height:68rpx;background:#E8EEF9;color:#2457D6;border-radius:14rpx;margin:0}
.chat-input{flex:1;background:#F4F7FC;border-radius:14rpx;padding:16rpx 20rpx;min-height:68rpx;font-size:27rpx}
.send{flex-shrink:0;background:#2457D6;color:#fff;border-radius:14rpx;font-size:26rpx;padding:0 26rpx;line-height:68rpx;margin:0}
.overlay{position:fixed;inset:0;background:rgba(20,33,61,.45);display:flex;align-items:flex-end;z-index:10}
.sheet{box-sizing:border-box;width:100%;max-height:88vh;overflow-y:auto;background:#fff;border-radius:28rpx 28rpx 0 0;padding:32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom))}
.sheet-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx}
.section-title{font-weight:700;font-size:34rpx}
.sub{font-size:24rpx;color:#74839A;line-height:1.6;margin-top:10rpx}
.label{font-size:25rpx;color:#526580;margin:22rpx 0 8rpx}
.input{box-sizing:border-box;background:#F4F7FC;border-radius:12rpx;padding:18rpx 20rpx;min-height:78rpx}
.primary{background:#2457D6;color:white;border-radius:14rpx;font-weight:600}
.submit{margin-top:32rpx}

.chips{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:6rpx}
.chip{padding:12rpx 24rpx;border-radius:999rpx;background:#F1F5FC;color:#3D5372;font-size:25rpx;border:2rpx solid transparent}
.chip-on{background:#E5ECFF;color:#2457D6;border-color:#2457D6;font-weight:600}
.hint{margin-top:12rpx;font-size:23rpx;color:#526580;background:#F4F7FC;border-radius:10rpx;padding:12rpx 16rpx;line-height:1.6}

.rich{max-width:100%;background:#fff;border-radius:18rpx;padding:10rpx 20rpx;box-sizing:border-box}
.rich towxml{display:block}

@import '../../styles/assistant.wxss';
.ai-orb { position:fixed; left:16px; z-index:80; }
.standalone-center { position: fixed; inset: 0; box-sizing: border-box; padding: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.standalone-assistant { position: relative; box-sizing: border-box; width: 92vw; max-width: 560px; height: 760px; max-height: 86%; min-height: 0; overflow: hidden; border-radius: 32px; transform-origin: top left; opacity: 0; pointer-events: auto; }
.standalone-assistant.panel-ready { opacity: 1; animation: standalone-panel-from-orb .34s cubic-bezier(.2,.85,.25,1); }
@keyframes standalone-panel-from-orb { from { opacity: .28; transform: var(--panel-enter-transform, translate(26px, -72px) scale(.08)); border-radius: var(--panel-enter-radius, 22px); } to { opacity: 1; transform: translate(0, 0) scale(1, 1); border-radius: 32px; } }

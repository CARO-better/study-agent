<view class="page">
  <view class="header"><view><view class="eyebrow">学程 / STUDY PLANNER</view><view class="heading">{{tab}}</view></view><view class="header-right"><view class="local">本地试用版</view><view class="bell" bindtap="openInbox">🔔<text wx:if="{{unread}}" class="badge">{{unread}}</text></view></view></view>
  <view class="notice">数据只保存在当前设备。点右上角消息可看当天未完成任务；云同步、AI、截图识别尚未接通。</view>
  <view wx:if="{{tab === '今日'}}">
    <view class="section-head"><view><view class="section-title">待办任务</view><view class="sub">{{today}} · 把下一步写下来</view></view><button class="primary small" bindtap="openTask">＋ 新任务</button></view>
    <view wx:if="{{!tasks.length}}" class="empty">还没有任务。添加课程和任务，开始安排学习。</view>
    <view wx:for="{{tasks}}" wx:key="id" class="task card"><view class="task-main" data-id="{{item.id}}" bindtap="toggleTask"><view class="check {{item.status === 'completed' ? 'checked' : ''}}">{{item.status === 'completed' ? '✓' : ''}}</view><view><view class="task-title {{item.status === 'completed' ? 'done' : ''}}">{{item.title}}</view><view class="sub">{{item.courseName}} · {{item.typeLabel}} · {{item.priorityLabel}}优先级</view><view class="sub">{{item.dueAt ? '截止 ' + item.dueAt : '无截止日期'}} · 预计 {{item.remainingMinutes}} 分钟</view></view></view><view class="actions"><text data-id="{{item.id}}" bindtap="openTask">编辑</text><text data-kind="task" data-id="{{item.id}}" bindtap="remove">删除</text></view></view>
    <view class="section-head"><view class="section-title">计划时间</view><text class="link" data-tab="计划" bindtap="switchTab">查看计划 →</text></view>
    <view wx:if="{{!blocks.length}}" class="empty compact">暂无排期，先在计划中添加可用时间。</view><view wx:for="{{blocks}}" wx:key="index" class="timeline"><view class="rail"></view><view><view>{{item.title}}</view><view class="sub">{{item.timeLabel}} {{item.locked ? '· 已锁定' : ''}}</view></view></view>
  </view>
  <view wx:if="{{tab === '课程'}}"><view class="section-head"><view><view class="section-title">我的课程</view><view class="sub">按学期记录，任务可关联课程</view></view><button class="primary small" bindtap="openCourse">＋ 课程</button></view><view wx:if="{{!store.courses.length}}" class="empty">还没有课程，添加一门开始吧。</view><view wx:for="{{store.courses}}" wx:key="id" class="card course"><view><view class="task-title">{{item.name}}</view><view class="sub">{{item.semester}}</view></view><view class="actions"><text data-id="{{item.id}}" bindtap="openCourse">编辑</text><text data-kind="course" data-id="{{item.id}}" bindtap="remove">删除</text></view></view></view>
  <view wx:if="{{tab === '计划'}}"><view class="section-head"><view><view class="section-title">可用时间</view><view class="sub">手动添加具体日期和时段</view></view><button class="primary small" bindtap="openAvailability">＋ 时段</button></view><view wx:if="{{!availability.length}}" class="empty compact">尚未添加可用时段。</view><view wx:for="{{availability}}" wx:key="id" class="row"><view>{{item.date}} {{item.startTime}}–{{item.endTime}}</view><text class="link" data-kind="availability" data-id="{{item.id}}" bindtap="remove">删除</text></view><view class="button-row"><button class="primary" bindtap="generate">生成本地计划</button><button class="secondary" bindtap="undo">撤销上次生成</button></view><view class="section-head"><view class="section-title">时间安排</view><view class="sub">锁定后重新排期会保留</view></view><view wx:if="{{!blocks.length}}" class="empty compact">还没有计划。</view><view wx:for="{{blocks}}" wx:key="index" class="timeline"><view class="rail"></view><view class="grow"><view>{{item.title}}</view><view class="sub">{{item.timeLabel}}</view></view><text class="link" data-index="{{index}}" bindtap="lock">{{item.locked ? '🔒 已锁定' : '锁定'}}</text></view><view class="section-title space">未安排</view><view wx:if="{{!unscheduled.length}}" class="sub">暂无未安排任务。</view><view wx:for="{{unscheduled}}" wx:key="index" class="row"><view>{{item.title}}<view class="sub">{{item.reasonLabel}}</view></view><view>{{item.remainingMinutes}} 分钟</view></view></view>
  <view wx:if="{{tab === '设置'}}"><view class="section-title">数据备份</view><view class="card prose">清微信缓存会把本机数据一起清掉，这是本地存储躲不掉的。导出一份文本存到微信收藏或「文件传输助手」，清缓存或换手机后粘贴回来即可恢复。备份里包含你的 API Key，不要发给别人。</view><view class="sub">上次备份：{{backupAt || '从未备份'}}</view><view class="button-row"><button class="primary" bindtap="exportBackup">导出到剪贴板</button><button class="secondary" bindtap="importBackup">从剪贴板恢复</button></view><view class="section-title space">关于试用版</view><view class="card prose">所有课程、任务和计划仅保存在本机微信存储中。清除小程序数据可能导致记录丢失。</view><view class="section-title space">尚未接通</view><view class="card prose">截图识别：并入 AI 助理（模型直接读图）<br/>AI 助手：已接通，需自填 Key<br/>云同步：未接通（云环境已初始化，可检测）<br/>微信推送：不使用，改为右上角站内消息</view><button class="secondary sample" bindtap="probeCloud">检测云端连接</button><button class="secondary" bindtap="previewMigrate" style="margin-bottom:16rpx">预览上云内容（不上传）</button><button class="primary" bindtap="uploadToCloud" style="margin-bottom:16rpx">上传到云端</button><button class="secondary" bindtap="restoreFromCloud" style="margin-bottom:24rpx">从云端恢复（清缓存后用）</button><button class="secondary sample" bindtap="sample">添加示例数据</button><view class="sub">示例只会在点击并确认后添加。</view></view>
</view>
<view class="bottom"><view wx:for="{{tabs}}" wx:key="*this" class="nav {{tab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="switchTab">{{item}}</view><view class="nav" bindtap="openAI">AI</view></view>
<view wx:if="{{showInbox}}" class="overlay"><view class="sheet inbox-sheet">
  <view class="sheet-head"><view class="section-title">消息</view><text class="link" bindtap="closeInbox">关闭</text></view>
  <view class="sub">每天一条，汇总当天的未完成任务。只保存在本机，不发送微信通知；点任务可切换完成状态。</view>
  <view wx:if="{{!inboxMessages.length}}" class="empty compact">还没有消息。</view>
  <view wx:for="{{inboxMessages}}" wx:key="date" class="msg">
    <view class="msg-head"><text class="msg-date">{{item.date}}</text><text class="sub">{{item.summary}}</text></view>
    <view wx:if="{{!item.items.length}}" class="sub">当天没有未完成任务。</view>
    <view wx:for="{{item.items}}" wx:for-item="task" wx:key="taskId" class="msg-item" data-id="{{task.taskId}}" bindtap="toggleFromInbox">
      <view class="check {{task.overdue ? 'overdue' : ''}}"></view>
      <view class="grow"><view class="msg-title">{{task.title}}</view><view class="sub">{{task.dueAt || '无截止日期'}}{{task.overdue ? ' · 已逾期' : ''}}</view></view>
    </view>
  </view>
</view></view>
<view wx:if="{{editing}}" class="overlay"><view class="sheet"><view class="sheet-head"><view class="section-title">{{editing === 'course' ? '课程' : editing === 'task' ? '任务' : '可用时间'}}</view><text class="link" bindtap="close">取消</text></view>
<block wx:if="{{editing === 'course'}}"><view class="label">学期</view><input class="input" placeholder="例如 2026 秋季" value="{{courseForm.semester}}" data-field="semester" bindinput="field"/><view class="label">课程名称</view><input class="input" placeholder="例如 软件工程" value="{{courseForm.name}}" data-field="name" bindinput="field"/><button class="primary submit" bindtap="saveCourse">保存课程</button></block>
<block wx:if="{{editing === 'task'}}"><view class="label">任务标题</view><input class="input" placeholder="例如 完成实验报告" value="{{taskForm.title}}" data-field="title" bindinput="field"/><view class="label">关联课程</view><picker range="{{courseNames}}" value="{{courseIndex}}" bindchange="chooseCourse"><view class="input">{{courseNames[courseIndex]}} ▾</view></picker><view class="label">类型</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="chooseType"><view class="input">{{types[typeIndex]}} ▾</view></picker><view class="label">截止日期</view><picker mode="date" value="{{taskForm.dueAt}}" data-field="dueAt" bindchange="field"><view class="input">{{taskForm.dueAt}} ▾</view></picker><view class="label">预计分钟数</view><input class="input" type="number" value="{{taskForm.remainingMinutes}}" data-field="remainingMinutes" bindinput="field"/><view class="label">优先级</view><picker range="{{priorities}}" value="{{priorityIndex}}" bindchange="choosePriority"><view class="input">{{priorities[priorityIndex]}} ▾</view></picker><button class="primary submit" bindtap="saveTask">保存任务</button></block>
<block wx:if="{{editing === 'availability'}}"><view class="label">日期</view><picker mode="date" value="{{availabilityForm.date}}" data-field="date" bindchange="field"><view class="input">{{availabilityForm.date}} ▾</view></picker><view class="label">开始</view><picker mode="time" value="{{availabilityForm.start}}" data-field="start" bindchange="field"><view class="input">{{availabilityForm.start}} ▾</view></picker><view class="label">结束</view><picker mode="time" value="{{availabilityForm.end}}" data-field="end" bindchange="field"><view class="input">{{availabilityForm.end}} ▾</view></picker><button class="primary submit" bindtap="saveAvailability">保存时段</button></block></view></view>
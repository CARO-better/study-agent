.dialog-root { position: fixed; inset: 0; z-index: 120; }
.dialog-veil { position: absolute; inset: 0; background: var(--veil); animation: surface-veil-in .18s ease-out; }
.dialog-positioner { position: absolute; inset: 0; box-sizing: border-box; padding: 12px 12px calc(12px + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; }
.dialog-card { position: relative; box-sizing: border-box; width: 88vw; max-width: 440px; max-height: 82%; border-radius: 24px; overflow: hidden; transform-origin: top left; }
.dialog-content-wrap { box-sizing: border-box; max-height: 76vh; overflow-y: auto; padding: 18px 18px 14px; }
.dialog-title { font-size: 17px; font-weight: 600; margin: 0 0 8px; color: var(--text); }
.dialog-copy { font-size: 14px; line-height: 1.6; color: var(--secondary); white-space: pre-wrap; overflow-wrap: anywhere; }
.dialog-input { box-sizing: border-box; width: 100%; min-height: 44px; margin: 12px 0 4px; padding: 10px 12px; border: 0; border-radius: 12px; background: var(--fill); color: var(--text); font-size: 15px; }
.dialog-actions { display: flex; gap: 10px; margin-top: 16px; }
.dialog-btn { flex: 1; min-height: 42px; border: 0; border-radius: 13px; background: var(--fill); color: var(--text); font-size: 15px; }
.dialog-btn.primary { background: var(--blue); color: #fff; }
.dialog-btn.danger { background: var(--red); color: #fff; }
.dialog-menu { display: grid; gap: 2px; margin-top: 10px; }
.dialog-menu-row { width: 100%; min-height: 44px; border: 0; border-radius: 12px; background: transparent; color: var(--text); text-align: left; padding: 0 12px; font-size: 15px; }
.dialog-menu-row:active { background: var(--fill); }
.dialog-card.phase-measuring { visibility: hidden; opacity: 0; }
.dialog-card.phase-entering { opacity: .86; transform: var(--morph-transform); border-radius: var(--morph-radius, 18px); transition: none; }
.dialog-card.phase-open { opacity: 1; transform: translate(0, 0) scale(1, 1); border-radius: 24px; transition: transform .3s cubic-bezier(.2,.85,.25,1), border-radius .3s, opacity .18s ease-out; }
.dialog-card.phase-closing { opacity: .3; transform: var(--morph-transform); border-radius: var(--morph-radius, 18px); transition: transform .26s cubic-bezier(.55,0,.9,.45), border-radius .26s, opacity .2s ease-in; }
.dialog-content-wrap { opacity: 1; transition: opacity .14s ease-out .1s; }
.dialog-card.phase-entering .dialog-content-wrap, .dialog-card.phase-closing .dialog-content-wrap { opacity: 0; transition: opacity .1s ease-in; }
.dialog-root.phase-closing .dialog-veil { pointer-events: none; animation: surface-veil-out .22s ease-in forwards; }
